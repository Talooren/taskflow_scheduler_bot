# ── Telegram ──────────────────────────────────────────────────────────────────
BOT_TOKEN=

# ── Airtable ──────────────────────────────────────────────────────────────────
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
# Имя таблицы. Если пустое — возьмётся дефолт "Итерация" из app/config.py.
AIRTABLE_TABLE=Итерация

# ── Telegram группы ───────────────────────────────────────────────────────────
# ID рабочей группы XX1.3 (куда идут публикации в PROD).
GROUP_ID=
# ID группы модераторов (куда идут карточки результатов и TEST_MODE-публикации).
MODERATOR_GROUP_ID=
# Telegram user id'ы модераторов через запятую: 123,456,789
MODERATOR_IDS=

# ── Тестовый режим ────────────────────────────────────────────────────────────
# true  — публикации идут в MODERATOR_GROUP_ID с префиксом [🧪 TEST],
#         берут задачу кнопкой, а не реакцией.
# false — боевой режим: публикации в GROUP_ID, взятие реакцией.
TEST_MODE=true
# Telegram user id тестировщика (в TEST_MODE он автоматически модератор).
TEST_USER_ID=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Хост `postgres` = имя сервиса в docker-compose сети taskflow_net.
POSTGRES_USER=taskflow
POSTGRES_DB=taskflow
POSTGRES_PASSWORD=
# PG_DSN собирается из значений выше. При деплое пароль подставляется
# одновременно в POSTGRES_PASSWORD и в PG_DSN.
PG_DSN=postgresql://taskflow:CHANGE_ME@postgres:5432/taskflow

# ── Redis ─────────────────────────────────────────────────────────────────────
# Хост `redis` = имя сервиса в docker-compose сети taskflow_net.
REDIS_URL=redis://redis:6379/0
